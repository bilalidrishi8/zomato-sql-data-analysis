--1. Find the top 10 restaurants based on rating.
SELECT * FROM zomato_restaurants

SELECT
    restaurant_name,
    city,
    aggregate_rating,
    votes
FROM zomato_restaurants
WHERE aggregate_rating > 0
ORDER BY aggregate_rating DESC, votes DESC
LIMIT 10;

--2. Find the top 10 restaurants based on votes.
SELECT * FROM zomato_restaurants

SELECT
    restaurant_name,
    city,
    votes,
    aggregate_rating
FROM zomato_restaurants
ORDER BY votes DESC
LIMIT 10;

--3. Find the most popular cuisine.
SELECT * FROM zomato_restaurants

SELECT
    cuisines,
    COUNT(*) AS restaurant_count
FROM zomato_restaurants
WHERE cuisines IS NOT NULL
GROUP BY cuisines
ORDER BY restaurant_count DESC
LIMIT 1;

--4. Find the average rating for each price range.
SELECT * FROM zomato_restaurants

SELECT
    price_range,
    ROUND(AVG(aggregate_rating), 2) AS average_rating
FROM zomato_restaurants
WHERE aggregate_rating > 0
GROUP BY price_range
ORDER BY price_range;

--5. Find cities with more than 100 restaurants.
SELECT * FROM zomato_restaurants

SELECT
    city,
    COUNT(*) AS restaurant_count
FROM zomato_restaurants
GROUP BY city
HAVING COUNT(*) > 100
ORDER BY restaurant_count DESC;

--6. Find the percentage of restaurants offering online delivery.
SELECT * FROM zomato_restaurants

SELECT
    ROUND(
        100.0 * COUNT(*) FILTER (
            WHERE LOWER(has_online_delivery) = 'yes'
        ) / COUNT(*),
        2
    ) AS online_delivery_percentage
FROM zomato_restaurants;

--7. Find the most expensive restaurants.
