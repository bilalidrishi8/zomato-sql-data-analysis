--8. Find the city with the highest average restaurant rating.
SELECT * FROM zomato_restaurants

SELECT
    city,
    ROUND(AVG(aggregate_rating), 2) AS average_rating
FROM zomato_restaurants
WHERE aggregate_rating > 0
GROUP BY city
ORDER BY average_rating DESC
LIMIT 1;

--9. Find the city with the highest average cost for two.
SELECT * FROM zomato_restaurants

SELECT
    city,
    ROUND(AVG(average_cost_for_two), 2) AS average_cost
FROM zomato_restaurants
